# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，勿提交

# 应用
APP_NAME=AI 智能客服系统
DEBUG=false
JSON_LOGS=false
LOG_LEVEL=INFO

# 数据库（PostgreSQL 15+，pgvector 已确认，见 08 §2/§10）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_customer_service

# Redis（B1 可选；B2 起 Celery 依赖）
REDIS_URL=redis://127.0.0.1:6379/0

# JWT（08 §8：生产环境必须替换为强随机值）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 文件存储目录
STORAGE_DIR=storage

# 任务执行：inline（默认，进程内异步）| celery（需 Redis + worker）
TASK_BACKEND=inline

# Embedding（08 §2/#2：bge-m3 1024 维；不配置 Key 时使用 mock 向量，仅限开发）
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# LLM（08 §2：智谱 GLM 起步；未配置 Key 时使用 mock 生成，仅限开发）
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4-flash
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 重排（Rerank）—— SiliconFlow（08 §11 #15；B3 起使用，Key 只放 .env）
RERANK_API_KEY=sk-xxxx
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
