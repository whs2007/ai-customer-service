# 复制为 .env 后填写真实值；.env 已被 gitignore，勿提交

# 运行环境：development / test / production（production 强制校验 JWT_SECRET）
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
JSON_LOGS=false

# 数据库 / 缓存（本地默认；docker 模式由 compose 覆盖为服务名）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_customer_service
REDIS_URL=redis://127.0.0.1:6379/0
# 测试库（可选：pytest 优先使用独立测试库，避免污染开发数据）
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_customer_service_test

# 连接池（并发对话与任务较多时调大）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=30000

# JWT：生产必须替换为强随机值
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ISSUER=ai-customer-service
JWT_AUDIENCE=ai-customer-service-web

# CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 任务执行方式：inline（进程内异步）/ celery（需 Redis）
TASK_BACKEND=inline

# LLM / Embedding / Rerank（生产填写真实 Key）
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4-flash
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 内容审核（可选外部 API；未配置走本地敏感词兜底）
MODERATION_ENABLED=true
MODERATION_API_URL=
MODERATION_API_KEY=

# 指标抓取专用 token（可选；配置后 /metrics 除 admin JWT 外也接受该 token）
METRICS_TOKEN=

# 上传限制（与前端 nginx client_max_body_size 保持一致）
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=.xlsx,.csv,.md,.txt,.pdf,.docx

# 速率限制（每分钟）
LOGIN_RATE_PER_MINUTE=10
REFRESH_RATE_PER_MINUTE=30
CHAT_RATE_PER_MINUTE=120

# 初始管理员引导（生产首次部署必填 ADMIN_INITIAL_PASSWORD）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_DISPLAY_NAME=管理员

# ---- docker compose 专用（backend/docker-compose.yml）----
# 生产禁止使用默认口令
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Grafana 管理员
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
