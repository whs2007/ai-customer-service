# 复制为 backend/.env 后填写真实值（完整模板见 backend/.env.example）；.env 已被 gitignore，勿提交

# 运行环境：development / test / production（production 强制校验 JWT_SECRET）
ENVIRONMENT=development
DEBUG=false
JSON_LOGS=false

# JWT：生产必须替换为强随机值
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production

# 测试库（可选）
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ai_customer_service_test

# 指标抓取专用 token（可选）
METRICS_TOKEN=

# 重排（Rerank）配置 —— SiliconFlow
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 初始管理员引导（生产首次部署必填 ADMIN_INITIAL_PASSWORD）
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
ADMIN_DISPLAY_NAME=管理员

# docker compose 专用
POSTGRES_PASSWORD=
REDIS_PASSWORD=
